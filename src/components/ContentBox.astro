---
// Native Astro port of src/components/contentBox.jsx.
// Wraps children in standard inner padding; opt in to wider vertical
// padding with `extraVerticalPadding`.
const {
  extraVerticalPadding = false,
  class: className,
  ...attributes
} = Astro.props
---

<div
  {...attributes}
  class:list={[
    'content-box',
    className,
    { 'extra-vertical': extraVerticalPadding },
  ]}
>
  <slot />
</div>

<style>
  .content-box {
    padding: var(--inner-padding);
  }

  .content-box.extra-vertical {
    padding-top: var(--outer-padding);
    padding-bottom: var(--outer-padding);
  }
</style>
